# Browser build: keep empty in production so requests remain same-origin through the BFF.
# VITE_API_BASE_URL=

# Server-only variables. Never prefix these with VITE_.
BACKEND_API_URL=https://bybit-intraday-backend-608992045433.asia-south1.run.app
BACKEND_ADMIN_TOKEN=replace-with-the-exact-cloud-run-admin-token

# Generate a scrypt hash locally. Format: scrypt$<salt>$<hex digest>
# Example generator:
# node -e "const {randomBytes,scryptSync}=require('crypto');const s=randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+scryptSync(process.argv[1],s,32).toString('hex'))" "your-long-password"
FRONTEND_OPERATOR_PASSWORD_SCRYPT=scrypt$replace-salt$replace-hex-digest
FRONTEND_SESSION_SIGNING_SECRET=replace-with-an-independent-64-character-random-secret

# BACKEND_ADMIN_TOKEN must exactly match the Cloud Run ADMIN_TOKEN secret.
# Operator password and session signing secret must be different values.
# Bybit credentials belong only in the backend environment.
