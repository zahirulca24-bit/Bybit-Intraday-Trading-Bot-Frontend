# Browser build: keep empty in production so requests remain same-origin through the Vercel BFF.
# VITE_API_BASE_URL=

# Server-only Vercel variables. Never prefix these with VITE_.
BACKEND_API_URL=https://bybit-intraday-backend-608992045433.asia-south1.run.app
BACKEND_ADMIN_TOKEN=replace-with-the-exact-cloud-run-admin-token
FRONTEND_CONTROL_TOKEN=replace-with-a-separate-long-random-operator-token

# BACKEND_ADMIN_TOKEN must exactly match the Cloud Run ADMIN_TOKEN secret.
# FRONTEND_CONTROL_TOKEN is only for operator login and signed HttpOnly sessions.
# Bybit credentials belong only in the backend environment.
# Never place BYBIT_API_KEY or BYBIT_API_SECRET in this frontend project.
