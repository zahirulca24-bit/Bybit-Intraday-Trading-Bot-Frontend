# Browser build: keep this empty in Vercel production so requests remain same-origin.
# Local development may point directly to Render, for example:
# VITE_API_BASE_URL=https://bybit-intraday-trading-bot.onrender.com

# Vercel server-side variables. Never prefix these with VITE_.
BACKEND_API_URL=https://bybit-intraday-trading-bot.onrender.com
BACKEND_ADMIN_TOKEN=replace-with-the-same-admin-token-used-by-render

# Bybit credentials belong only in Render backend environment variables.
# Never place BYBIT_API_KEY or BYBIT_API_SECRET in this frontend project.
