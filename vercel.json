{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/scanner-live.ts": { "maxDuration": 30 },
    "api/execution-truth.ts": { "maxDuration": 30 },
    "api/status-truth.ts": { "maxDuration": 30 },
    "api/lifecycle-truth.ts": { "maxDuration": 30 },
    "api/bot-toggle.ts": { "maxDuration": 30 },
    "api/analytics.ts": { "maxDuration": 30 },
    "api/risk-policy.ts": { "maxDuration": 30 },
    "api/auth/login.ts": { "maxDuration": 10 },
    "api/auth/logout.ts": { "maxDuration": 10 },
    "api/auth/session.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth/login" },
    { "source": "/api/auth/logout", "destination": "/api/auth/logout" },
    { "source": "/api/auth/session", "destination": "/api/auth/session" },
    { "source": "/api/status", "destination": "/api/status-truth" },
    { "source": "/api/orders/lifecycle", "destination": "/api/lifecycle-truth" },
    { "source": "/api/scanner", "destination": "/api/scanner-live" },
    { "source": "/api/execution-truth", "destination": "/api/execution-truth" },
    { "source": "/api/bot/toggle", "destination": "/api/bot-toggle" },
    { "source": "/api/risk/policy", "destination": "/api/risk-policy" },
    { "source": "/api/analytics/:path*", "destination": "/api/analytics?path=:path*" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
