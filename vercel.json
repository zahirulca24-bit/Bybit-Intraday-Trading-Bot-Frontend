{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/scanner-live.ts": {
      "maxDuration": 30
    },
    "api/bot-toggle.ts": {
      "maxDuration": 30
    },
    "api/analytics.ts": {
      "maxDuration": 30
    },
    "api/risk-policy.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/scanner", "destination": "/api/scanner-live" },
    { "source": "/api/bot/toggle", "destination": "/api/bot-toggle" },
    { "source": "/api/risk/policy", "destination": "/api/risk-policy" },
    { "source": "/api/analytics/:path*", "destination": "/api/analytics?path=:path*" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
