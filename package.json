{
  "name": "bybit-demo-intraday-trading-bot-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx render-server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --import tsx --test tests/control-auth.test.ts tests/auth-completion.test.ts",
    "test:scanner": "node --import tsx --test tests/scanner-integrity.test.ts",
    "test:lifecycle": "node --import tsx --test tests/lifecycle-truth.test.ts",
    "test:execution-truth": "node --import tsx --test tests/execution-truth-contract.test.ts",
    "test:ui-verification": "node --import tsx --test tests/ui-verification-f3.test.ts",
    "test:e2e": "node e2e/run-e2e-wrapper.mjs",
    "verify": "npm run typecheck && npm run test:auth && npm run test:scanner && npm run test:lifecycle && npm run test:execution-truth && npm run test:ui-verification && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0", "@tailwindcss/vite": "^4.1.14", "@vitejs/plugin-react": "^5.0.4", "dotenv": "^17.2.3", "express": "^4.21.2", "lightweight-charts": "^5.2.0", "lucide-react": "^0.546.0", "motion": "^12.23.24", "react": "^19.0.1", "react-dom": "^19.0.1", "tsx": "^4.21.0", "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2", "@types/express": "^4.17.21", "@types/node": "^22.14.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "autoprefixer": "^10.4.21", "esbuild": "^0.25.0", "tailwindcss": "^4.1.14", "typescript": "~5.8.2"
  }
}
